# PostgreSQL (Prisma)
DATABASE_URL=
DIRECT_URL=

# Session signing (required in production — use a long random string)
AUTH_SECRET=

# Persistent goal images: public Supabase Storage bucket named "goals".
# Set both variables in Vercel for the environments you deploy to.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: first admin user created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
