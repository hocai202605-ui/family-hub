generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum AssetType {
  GOLD
  STOCK
  SAVING
  REAL_ESTATE
  CRYPTO
  DEBT
  LOAN
  OTHER
  FUND_DCDS
  FUND_ETF_VN30
  DEBT_INTEREST
}

enum FamilyMember {
  CK
  VK
  CON
  GIA_DINH
}

enum Role {
  ADMIN
  USER
}

/// `createdBy` / `updatedBy` on domain tables store **User.name** (username text), not FK relations.
model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String
  passwordHash    String
  role            Role             @default(USER)
  isActive        Boolean          @default(true)
  lastLoginAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  menuPermissions MenuPermission[]

  @@map("users")
}

model MenuPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  menuKey   String
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuKey])
  @@index([menuKey])
  @@map("menu_permissions")
}

model Category {
  id        String       @id
  label     String
  icon      String       @default("banknote")
  badge     String       @default("bg-slate-100 text-slate-700 ring-slate-200")
  chart     String       @default("#64748b")
  type      CategoryType @default(EXPENSE)
  createdBy String?
  updatedBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([label, type])
  @@map("categories")
}

model Expense {
  id        Int          @id @default(autoincrement())
  amount    Int
  category  String
  member    FamilyMember
  note      String
  date      DateTime
  createdBy String?
  updatedBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([date])
  @@index([category])
  @@map("expenses")
}

/// Monthly spending limit (VND) keyed by calendar month `YYYY-MM`.
model MonthlyBudget {
  id        Int      @id @default(autoincrement())
  month     String   @unique
  amount    Int
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("monthly_budgets")
}

model Income {
  id        Int          @id @default(autoincrement())
  amount    Int
  category  String
  member    FamilyMember
  note      String
  date      DateTime     @db.Date
  createdBy String?
  updatedBy String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([date])
  @@index([category])
  @@map("incomes")
}

model Investment {
  id            Int          @id @default(autoincrement())
  name          String
  type          AssetType
  quantity      Float
  purchasePrice Float
  currentPrice  Float
  interestRate  Float?
  term          String?
  member        FamilyMember
  note          String?
  date          DateTime     @db.Date
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("investments")
}

// --- Personal growth / daily calendar (menuKey: calendar) ---

/// Habit definition for a member within a calendar month (YYYY-MM).
model GrowthHabit {
  id        String             @id @default(cuid())
  member    FamilyMember
  month     String
  name      String
  color     String             @default("amber")
  sortOrder Int                @default(0)
  createdBy String
  updatedBy String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  checks    GrowthHabitCheck[]

  @@index([member, month])
  @@map("growth_habits")
}

/// Per-day completion for a habit within a Mon–Sun week (dayIndex 0–6).
model GrowthHabitCheck {
  id        String      @id @default(cuid())
  habitId   String
  weekStart DateTime    @db.Date
  dayIndex  Int
  completed Boolean     @default(false)
  createdBy String
  updatedBy String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  habit     GrowthHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, weekStart, dayIndex])
  @@index([weekStart])
  @@map("growth_habit_checks")
}

/// Weekly or monthly plan checklist item.
model GrowthPlanItem {
  id          String       @id @default(cuid())
  member      FamilyMember
  scope       String
  month       String
  weekStart   DateTime?    @db.Date
  text        String
  isCompleted Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdBy   String
  updatedBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([member, month])
  @@index([member, weekStart])
  @@map("growth_plan_items")
}

/// One daily log row (top 5 + reflection); tick-notes are children.
model GrowthDailyLog {
  id         String           @id @default(cuid())
  member     FamilyMember
  date       DateTime         @db.Date
  reflection String           @default("")
  top5Tasks  Json
  createdBy  String
  updatedBy  String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tickNotes  GrowthTickNote[]

  @@unique([member, date])
  @@index([date])
  @@map("growth_daily_logs")
}

model GrowthTickNote {
  id          String         @id @default(cuid())
  dailyLogId  String
  text        String
  isCompleted Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdBy   String
  updatedBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  dailyLog    GrowthDailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)

  @@index([dailyLogId])
  @@map("growth_tick_notes")
}

model GrowthCalendarEvent {
  id        String       @id @default(cuid())
  member    FamilyMember
  date      DateTime     @db.Date
  text      String
  createdBy String
  updatedBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([member, date])
  @@map("growth_calendar_events")
}
